FROM python:3.12-slim AS builder
WORKDIR /app
COPY packages/ packages/
COPY common/ common/
COPY services/gateway/ services/gateway/
RUN pip install --no-cache-dir \
    -e packages/agents \
    -e packages/quality \
    -e common/contracts \
    -e services/gateway
ENV PYTHONPATH=/app
EXPOSE 8001
CMD ["uvicorn", "services.gateway.main:app", "--host", "0.0.0.0", "--port", "8001"]
