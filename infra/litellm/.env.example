# LiteLLM proxy environment variables
# Copy to .env.production and fill in secrets via CI/CD or secrets manager

# === LiteLLM master key ===
LITELLM_MASTER_KEY=           # generate: openssl rand -hex 32
LITELLM_SALT_KEY=             # generate: openssl rand -hex 32

# === 9Router ===
NINE_ROUTER_API_KEY=          # API key for 9Router

# === Database (production only) ===
DATABASE_URL=                 # postgresql://litellm:PASSWORD@db:5432/litellm
POSTGRES_PASSWORD=            # generate: openssl rand -hex 16

# === Redis (production only) ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=               # generate: openssl rand -hex 16
