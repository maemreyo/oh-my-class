# ════════════════════════════════════════════════════════════════════
# oh-my-class — Environment Variables
# Copy to .env and fill in real values before running docker-compose up
# ════════════════════════════════════════════════════════════════════

# ── LLM Connection (9Router sidecar) ────────────────────────────────
# All LLM traffic routes through 9Router. LiteLLM is optional/bypassed.
LLM_BASE_URL=http://localhost:20228/v1
LLM_API_KEY=niner-...
LLM_TIMEOUT_S=300
LLM_MAX_RETRIES=0
LLM_TEMPERATURE=0.1

# ── Model Assignments (9Router combo names) ──────────────────────────
# All default to 4omc. Override per-task for production cost optimization.
# See AGENTS.md §6.1 for recommended production assignments.
#
# Tier aliases — set once to apply to all tasks in that tier:
#   MODEL_STRONG_DEFAULT  strong tier: blueprint_design, content_generation,
#                         llm_judge, fact_verification, quality_gate
#   MODEL_FAST_DEFAULT    fast tier: summarization, title_generation,
#                         schema_rewrite
#
# Fallback order: MODEL_<TASK> > MODEL_<TIER>_DEFAULT > "4omc"
# Single-model deployments: leave these unset, every task uses "4omc".
MODEL_STRONG_DEFAULT=
MODEL_FAST_DEFAULT=
#
# Per-task overrides (uncomment and set to override the tier alias):
MODEL_LEAD_AGENT=4omc
MODEL_PLANNER=4omc
MODEL_RESEARCHER=4omc
MODEL_CONTENT_CREATOR=4omc
MODEL_REVIEWER=4omc
MODEL_DIAGNOSTICIAN=4omc
MODEL_LLM_JUDGE=4omc
MODEL_FACT_VERIFICATION=4omc
MODEL_QUALITY_GATE=4omc
MODEL_BLUEPRINT_DESIGN=4omc
MODEL_CONTENT_GENERATION=4omc
MODEL_SCHEMA_REWRITE=4omc
MODEL_SUMMARIZATION=4omc
MODEL_TITLE_GENERATION=4omc
MODEL_CONTENT_REVIEW_LIGHT=4omc

# ── Max Tokens per Agent (thinking budget) ───────────────────────────
# Caps total output (thinking + content) so reasoning models can't
# burn unlimited tokens. Lower = faster fail → healing reroutes.
MAX_TOKENS_PLANNER=8192
MAX_TOKENS_RESEARCHER=8192
MAX_TOKENS_CONTENT_CREATOR=16384
MAX_TOKENS_DIAGNOSTICIAN=4096
MAX_TOKENS_REVIEWER=4096
MAX_TOKENS_DEFAULT=8192

# ── Token Budgets (cost tracking, separate from MAX_TOKENS thinking caps) ──
# Soft limits: log warning when exceeded, never truncate. Hard limits: passed
# as max_tokens to the LLM (short structured outputs only).
BUDGET_CONTENT_GENERATION_SOFT_LIMIT=12000
BUDGET_BLUEPRINT_DESIGN_SOFT_LIMIT=6000
BUDGET_FACT_VERIFICATION_SOFT_LIMIT=4000
BUDGET_QUALITY_GATE_SOFT_LIMIT=3000
BUDGET_SUMMARIZATION_HARD_LIMIT=800
BUDGET_TITLE_GENERATION_HARD_LIMIT=100
BUDGET_SCHEMA_REWRITE_HARD_LIMIT=2000
BUDGET_CONTENT_REVIEW_LIGHT_HARD_LIMIT=1500
BUDGET_EMA_ALPHA=0.1
BUDGET_EMA_HEADROOM=1.5
BUDGET_EMA_MIN_SAMPLES=5

# ── 9Router Web Tools ────────────────────────────────────────────────
NINEROUTER_TIMEOUT=30
NINEROUTER_SEARCH_RESULTS=5
NINEROUTER_MIN_SOURCES=2
NINEROUTER_FETCH_LIMIT_BASIC=2
NINEROUTER_FETCH_LIMIT_STANDARD=5
NINEROUTER_FETCH_LIMIT_RIGOROUS=10
NINEROUTER_CONTENT_TRUNCATE=4000
# Direct overrides for the NineRouterWebClient HTTP client (defaults to
# http://localhost:20128/v1 if unset — a separate sidecar port from LLM_BASE_URL).
NINEROUTER_BASE_URL=
NINEROUTER_API_KEY=

# ── 9Router (release evidence provider) ──────────────────────────────
OMC_9ROUTER_BASE_URL=http://127.0.0.1:20228
OMC_9ROUTER_MODEL=4omc

# ── Quality Gates ────────────────────────────────────────────────────
# Adaptive fast-lane: auto-approve content_approval / blueprint_approval
# when teacher trust score >= threshold. Leave unset to disable (default).
# Recommended range: 0.80–0.95. Trust score = rolling average of last 10
# gate events: approve→1.0, minor-edit→0.5, reject→0.0.
GATE_FAST_LANE_THRESHOLD=
GATE_PREFLIGHT_MIN_LENGTH=10
GATE_TITLE_MAX_LENGTH=50
GATE_JUDGE_MIN_WORDS_LESSON=180
GATE_JUDGE_MIN_WORDS_WORKSHEET=90
GATE_JUDGE_MIN_WORDS_QUIZ=60
GATE_JUDGE_MIN_WORDS_DRILL=80
GATE_JUDGE_MIN_WORDS_RECAP=80
GATE_JUDGE_MIN_WORDS_INFOGRAPHIC=60
GATE_JUDGE_MIN_WORDS_DEFAULT=80
# Layer 1: schema validation retries / circuit breaker
GATE_SCHEMA_MAX_RETRIES=3
GATE_SCHEMA_CIRCUIT_THRESHOLD=3
GATE_SCHEMA_CIRCUIT_RECOVERY_S=60.0
# Layer 2-3: content review
GATE_FACT_MIN_SOURCES=2
GATE_FACT_POLICY=standard
GATE_AGE_CHECK_ENABLED=true
GATE_HTML_VALIDATE_ENABLED=true
GATE_RESPONSIVE_CHECK_ENABLED=false
# Layer 4: LLM judge
GATE_JUDGE_MODEL=4omc
GATE_JUDGE_MIN_SCORE=7.0
GATE_JUDGE_N=1
GATE_JUDGE_TEMPERATURE=0.1
# Layer 5: HITL
GATE_HITL_TIMEOUT_HOURS=24
GATE_HITL_AUTO_ESCALATE=true
GATE_HITL_MAX_REVISIONS=3
# Layer 6: export readiness
GATE_EXPORT_CONSENSUS_THRESHOLD=0.67
GATE_EXPORT_MIN_SCORE=7.0
# Healing / retry
GATE_MAX_RETRIES=3
GATE_HEALING_BASE_DELAY_S=0.5
GATE_HEALING_MAX_DELAY_S=10.0

# ── Teaching Pack Runtime ─────────────────────────────────────────────
TEACHING_PACK_ENABLED=true
TEACHING_PACK_REQUIRE_POSTGRES=true
TEACHING_PACK_DEFAULT_ARTIFACT_PARALLELISM=2
TEACHING_PACK_MAX_RUN_DURATION_SECONDS=3600
TEACHING_PACK_MAX_STAGE_DURATION_SECONDS=900
TEACHING_PACK_MAX_ARTIFACT_ATTEMPTS=3
TEACHING_PACK_MAX_HEALING_ATTEMPTS=3
TEACHING_PACK_MAX_PROMPT_CHARS=120000
TEACHING_PACK_CAPTURE_FULL_PROMPT_IO=false
TEACHING_PACK_FORCE_ESCALATE=       # debug/test only — forces healing to escalate

# ── Feature Flags ─────────────────────────────────────────────────────
FEATURE_TOPIC_DECOMPOSITION_V1=false
FEATURE_VOCABULARY_BATCH_V1=false
FEATURE_COMPONENT_STRATEGIST_V1=false
FEATURE_COMPONENT_STRATEGIST_INTERNAL_TEACHERS=   # CSV allowlist of teacher IDs
FEATURE_COMPONENT_STRATEGIST_KILL_SWITCH=false
UNIT_FANOUT_CONCURRENCY=1
# Teaching Pack has a second, independently-gated pair of flags (not unified
# with the ones above — see packages/agents/teaching_pack/features.py):
OMC_FEATURE_TOPIC_DECOMPOSITION_V1=
OMC_ROLLBACK_ARTIFACT_SEND_FANOUT_V1=

# ── Runtime / Worker ──────────────────────────────────────────────────
APP_ENV=development
OMC_ENVIRONMENT=development
OMC_ENABLE_SIX_LAYER_QUALITY=true
WORKER_MODE=in_process
WORKER_CONCURRENCY=1

# ── SLO Alerting (distinct from Teacher Gate webhooks below) ─────────
OMC_SLO_SLACK_WEBHOOK_URL=
OMC_SLO_ZALO_WEBHOOK_URL=

# ── Outbound Webhooks (effectiveness ingestion) ──────────────────────
WEBHOOK_OUTBOUND_URLS=              # comma-separated
WEBHOOK_NOTIFY_SECRET=
WEBHOOK_RATE_LIMIT_COUNT=60
WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60

# ── Free-tier Provider Keys (configured IN 9Router dashboard) ────────
KIRO_AI_API_KEY=          # AWS Builder ID — Claude 4.5 free tier
OPENCODE_API_KEY=         # OpenCode free tier
VERTEX_AI_API_KEY=        # Google Vertex AI ($300 one-time credit)
VERTEX_AI_PROJECT=        # GCP project ID for Vertex AI

# ── LiteLLM Proxy (OPTIONAL — only needed for production 2-layer) ────
# In dev mode, agents bypass LiteLLM and call 9Router directly.
# For production budget control, enable LiteLLM and set:
# LLM_BASE_URL=http://litellm:4000
# LITELLM_MASTER_KEY=sk-master-...
# LITELLM_SALT_KEY=

# ── Database ─────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=oh_my_class
POSTGRES_USER=omc_dev
POSTGRES_PASSWORD=changeme-in-production
# Literal value — do NOT use ${VAR} shell-expansion syntax here. docker-compose
# expands it natively, but a bare Python process reading .env via python-dotenv/
# pydantic-settings does not, and silently gets the broken literal string
# (this bit the Promptfoo subprocess provider — see LGH-06). Keep this in sync
# with POSTGRES_USER/PASSWORD/HOST/PORT/DB above by hand.
DATABASE_URL=postgresql://omc_dev:changeme-in-production@localhost:5432/oh_my_class

# ── Redis ────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# Literal value — see DATABASE_URL's comment above for why, not ${VAR}.
REDIS_URL=redis://redis:6379

# ── Gateway Service ──────────────────────────────────────────────────
GATEWAY_PORT=8001
GATEWAY_HOST=0.0.0.0

# ── Web Dashboard ────────────────────────────────────────────────────
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8001

# ── Webhook Notifications (Teacher Gate alerts) ──────────────────────
TELEGRAM_BOT_TOKEN=       # Optional
TELEGRAM_CHAT_ID=         # Optional
ZALO_OA_TOKEN=            # Optional
SLACK_WEBHOOK_URL=        # Optional

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=changeme-use-openssl-rand-base64-32
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── Webhook Security ─────────────────────────────────────────────────
TELEGRAM_WEBHOOK_SECRET=
ZALO_WEBHOOK_SECRET=

# ── Observability (Langfuse) ─────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=              # legacy alias, used only if LANGFUSE_BASE_URL is unset
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=

# ── Safety ───────────────────────────────────────────────────────────
# All paid model fallbacks are DISABLED.
# When 9Router is unreachable → system fails safely (queues run / returns error).
# NEVER add OPENAI_API_KEY or ANTHROPIC_API_KEY here.
