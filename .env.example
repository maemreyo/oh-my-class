# ════════════════════════════════════════════════════════════════════
# oh-my-class — Environment Variables
# Copy to .env and fill in real values before running docker-compose up
# ════════════════════════════════════════════════════════════════════

# ── 9Router Sidecar (PRIMARY — all LLM traffic routes through here) ──
# NOTE: 9Router is designed for developer coding sessions (OAuth-based).
# For production, consider Vertex AI service account or direct provider API keys.
# In dev mode, 9Router runs locally and developer logs in once via browser.
NINEROUTER_API_KEY=niner-...

# ── Free-tier Provider Keys (configured IN 9Router, not in LiteLLM) ──
KIRO_AI_API_KEY=          # AWS Builder ID — Claude 4.5 free tier
OPENCODE_API_KEY=         # OpenCode free tier
VERTEX_AI_API_KEY=        # Google Vertex AI ($300 one-time credit)
VERTEX_AI_PROJECT=        # GCP project ID for Vertex AI

# ── LiteLLM Proxy ──
LITELLM_MASTER_KEY=sk-master-...
# LITELLM_SALT_KEY=        # Optional: for key hashing

# ── Database ──
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=oh_my_class
POSTGRES_USER=omc_dev
POSTGRES_PASSWORD=changeme-in-production
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis (LiteLLM cache + LangGraph shared state) ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# ── Gateway Service ──
GATEWAY_PORT=8001
GATEWAY_HOST=0.0.0.0

# ── Web Dashboard ──
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8001

# ── Webhook Notifications (Teacher Gate alerts) ──
TELEGRAM_BOT_TOKEN=       # Optional: Telegram notifications
TELEGRAM_CHAT_ID=         # Optional: Target chat/group ID
ZALO_OA_TOKEN=            # Optional: Zalo Official Account
SLACK_WEBHOOK_URL=        # Optional: Slack alerts (9Router down, cost alerts)

# ── Auth (Layer 5 — teacher approval gates) ──
JWT_SECRET=changeme-use-openssl-rand-base64-32
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── Webhook Security ──
TELEGRAM_WEBHOOK_SECRET=       # HMAC secret for Telegram webhook verification
ZALO_WEBHOOK_SECRET=           # Shared secret for Zalo webhook verification

# ── Observability (Langfuse — self-hosted, free) ──
LANGFUSE_PUBLIC_KEY=          # Create in Langfuse UI after first login
LANGFUSE_SECRET_KEY=          # Create in Langfuse UI after first login
LANGFUSE_HOST=http://localhost:3001  # Self-hosted Langfuse URL
LANGFUSE_NEXTAUTH_SECRET=     # Generate: openssl rand -base64 32
LANGFUSE_SALT=                # Generate: openssl rand -base64 32

# ── Safety ──
# CRITICAL: All paid model fallbacks are DISABLED in config.yaml
# When 9Router is unreachable, system fails safely (queues run / returns error)
# NEVER add OPENAI_API_KEY or ANTHROPIC_API_KEY here — they should NOT be used
