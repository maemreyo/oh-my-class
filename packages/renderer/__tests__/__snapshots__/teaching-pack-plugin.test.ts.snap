      --color-category-a-tint: rgba(51,80,143,0.08);
      --color-category-b: #B9762A;
      --color-category-b-tint: rgba(185,118,42,0.09);
      --color-category-c: #3C7A4E;
      --color-category-c-tint: rgba(60,122,78,0.08);
      --color-category-d: #1F7A8C;
      --color-category-d-tint: rgba(31,122,140,0.08);
      --color-category-e: #8A4F7E;
