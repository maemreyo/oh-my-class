exports[`missing contract artifact plugins > renders exit_ticket standalone HTML with a manifest > exit-ticket-student-preview 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fraction Exit Ticket — oh-my-class</title>
  <style>
    :root {
      --color-bg: #FBF4F0;
      --color-bg-card: #FFFFFF;
      --color-bg-deep: #F3E2D9;
      --color-text: #22273A;
      --color-text-soft: #5C6275;
      --color-text-faint: #8B8FA0;
      --color-border: #E8D8CD;
      --color-border-soft: #EFE3DA;
      --color-accent: #B23A2E;
      --color-accent-deep: #8C2C22;
      --color-accent-tint: rgba(178,58,46,0.07);
      --color-success: #2E6F4E;
      --color-warning: #A8782E;
      --color-error: #B23A2E;
      --color-category-a: #33508F;
      --color-category-a-tint: rgba(51,80,143,0.08);
      --color-category-b: #B9762A;
      --color-category-b-tint: rgba(185,118,42,0.09);
      --color-category-c: #3C7A4E;
      --color-category-c-tint: rgba(60,122,78,0.08);
      --color-category-d: #1F7A8C;
      --color-category-d-tint: rgba(31,122,140,0.08);
      --color-category-e: #8A4F7E;
      --color-category-e-tint: rgba(138,79,126,0.08);
      --font-heading: 'Spectral', Georgia, 'Times New Roman', serif;
      --font-body: -apple-system, BlinkMacSystemFont, 'Be Vietnam Pro', 'Segoe UI', sans-serif;
      --font-mono: 'IBM Plex Mono', 'Fira Code', 'Courier New', monospace;    }

    *, *::before, *::after { box-sizing: border-box; }

    body {
      font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
      margin: 0;
      padding: 0;
      background: var(--color-bg, #fafafa);
      color: var(--color-text, #1a1a2e);
      line-height: 1.65;
    }

    .omc-header {
      padding: 1rem 1.5rem;
      border-bottom: 2px solid var(--color-border, #e2e8f0);
      margin-bottom: 1.5rem;
      display: flex;
      align-items: baseline;
      gap: 1rem;
    }
    .omc-header .brand { font-weight: 700; color: var(--color-accent, #b23a2e); font-size: 0.8rem; letter-spacing: 0.05em; text-transform: uppercase; }
    .omc-header .title { font-size: 1.35rem; font-weight: 600; margin: 0; flex: 1; }
    .omc-header .meta { color: var(--color-text-soft, #5c6275); font-size: 0.875rem; white-space: nowrap; }

    main { padding: 0 1.5rem 2rem; max-width: 900px; margin: 0 auto; }

    .timed-quiz-summary {
      border: 1px solid var(--color-border, #e2e8f0);
      border-radius: 0.75rem;
      padding: 0.75rem 1rem;
      background: var(--color-bg-card, #fff);
      color: var(--color-text, #1a1a2e);
    }
    .time-badge {
      display: inline-block;
      margin: 0.5rem 0;
      border: 1px solid var(--color-border, #e2e8f0);
      border-radius: 999px;
      padding: 0.2rem 0.65rem;
      font-size: 0.875rem;
      color: var(--color-text-soft, #5c6275);
      background: var(--color-bg, #fafafa);
    }

    .omc-footer {
      margin-top: 2rem;
      padding: 1rem 1.5rem;
      border-top: 1px solid var(--color-border, #e2e8f0);
      color: var(--color-text-faint, #8b8fa0);
      font-size: 0.8rem;
    }

    /* WCAG 2.2 AA — ensure focused/targeted elements are not obscured by sticky header */
    :target, :focus { scroll-margin-top: 4rem; }

    @media print {
      .no-print { display: none !important; }
      body { background: white; }
      .omc-footer { border-top: 1px solid #ccc; }
    }
      </style>
</head>
<body class="artifact artifact--exit_ticket">
  <header class="omc-header">
    <span class="brand">oh-my-class</span>
    <h1 class="title">Fraction Exit Ticket</h1>
        <div class="meta">
      <span class="subject">Math</span>       ·       <span class="grade">Grade 5</span>    </div>
      </header>

  <main id="main-content">
    <section class="exit-ticket-page"><div class="exit-ticket-header"><h2 class="exit-ticket-title">Vé Ra Lớp</h2><div class="exit-ticket-student"><span id="exit-ticket-student-name-label">Họ tên:</span> <span class="blank-line" role="textbox" aria-labelledby="exit-ticket-student-name-label"></span></div></div><ol class="exit-ticket-questions"><li class="exit-ticket-question"><p class="question-prompt"><span class="question-number" aria-hidden="true">1.</span> 1/2 = __/4</p><div class="answer-line"></div></li><li class="exit-ticket-question"><p class="question-prompt"><span class="question-number" aria-hidden="true">2.</span> How confident are you?</p><div class="rating-scale" role="radiogroup" aria-label="Rating 1-5"><label class="rating-option"><input type="radio" name="et-et2" value="1" /><span>1</span></label><label class="rating-option"><input type="radio" name="et-et2" value="2" /><span>2</span></label><label class="rating-option"><input type="radio" name="et-et2" value="3" /><span>3</span></label><label class="rating-option"><input type="radio" name="et-et2" value="4" /><span>4</span></label><label class="rating-option"><input type="radio" name="et-et2" value="5" /><span>5</span></label></div></li><li class="exit-ticket-question"><p class="question-prompt"><span class="question-number" aria-hidden="true">3.</span> Pick an equivalent fraction.</p><div class="options-grid" role="radiogroup"><label class="option"><input type="radio" name="et-et3" value="A" /><span class="option-label" aria-hidden="true">A</span><span class="option-text">2/4</span></label><label class="option"><input type="radio" name="et-et3" value="B" /><span class="option-label" aria-hidden="true">B</span><span class="option-text">2/5</span></label></div></li></ol><footer class="exit-ticket-footer no-print"><span>Hoàn thành trước khi ra về</span></footer></section>  </main>

  <footer class="omc-footer">
    <span>Generated by oh-my-class</span>
  </footer>
</body>
</html>
"
`;

