# Production template — committed, NO secrets
# Fill in values via CI/CD secrets manager (GitHub Actions, Doppler, Vault, etc.)
# Used by docker-compose.prod.yml override

# LLM Client — routes through LiteLLM in production
LLM_CLIENT_BASE_URL=http://litellm:4000
LLM_CLIENT_API_KEY=${LITELLM_AGENT_KEY}    # virtual key from create-keys.sh
LLM_CLIENT_TIMEOUT_S=120

# LiteLLM proxy
LITELLM_MASTER_KEY=                        # fill in deployment
LITELLM_SALT_KEY=                          # fill in deployment

# 9Router
NINE_ROUTER_API_KEY=                       # fill in deployment

# Database (LiteLLM uses Postgres for key/spend tracking)
POSTGRES_PASSWORD=                         # fill in deployment

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=                                # fill in deployment

# Langfuse
LANGFUSE_ENCRYPTION_KEY=                   # fill in deployment; never all-zero
LANGFUSE_NEXTAUTH_SECRET=                  # fill in deployment

# Storage / analytics backends
CLICKHOUSE_PASSWORD=                       # fill in deployment
MINIO_ROOT_PASSWORD=                       # fill in deployment

# Quality gate thresholds (production: stricter)
GATE_JUDGE_MIN_SCORE=7.0
GATE_MAX_RETRIES=3
GATE_RESPONSIVE_CHECK_ENABLED=true

# Max tokens per agent (thinking budget)
MAX_TOKENS_PLANNER=8192
MAX_TOKENS_RESEARCHER=8192
MAX_TOKENS_CONTENT_CREATOR=16384
MAX_TOKENS_DIAGNOSTICIAN=4096
MAX_TOKENS_REVIEWER=4096
MAX_TOKENS_DEFAULT=8192
